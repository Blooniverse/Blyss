{
  "name": "@blooniverse/blyss",
  "version": "1.0.1",
  "description": "Blyss is a lean, local-first Markdown++ SSG (static site generator) and dependency free Node.js server. ",
  "keywords": [
    "static-site-generator",
    "ssg",
    "markdown",
    "multilingual",
    "i18n",
    "json-ld",
    "sitemap",
    "mathml",
    "documentation",
    "blog"
  ],
  "homepage": "https://github.com/Blooniverse/Blyss#readme",
  "bugs": {
    "url": "https://github.com/Blooniverse/Blyss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blooniverse/Blyss.git"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "blyss": "bin/blyss.js"
  },
  "files": [
    "bin/",
    "src/",
    "starters/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node bin/blyss.js build",
    "check": "node bin/blyss.js check",
    "dev": "node bin/blyss.js serve --watch --drafts",
    "start": "node bin/blyss.js serve",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "temml": "0.14.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
