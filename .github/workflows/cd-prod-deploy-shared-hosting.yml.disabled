# Historical example.
# Chk settings, esp. `rsync --delete`.
name: Build and deploy Blyss to a shared hosting environment

on:
  push:
    branches:
      - main

permissions:
  contents: read

concurrency:
  group: production
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build static website
        run: npm run build

      - name: Configure SSH
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SRV_SSH_PRIVATE_KEY }}
          SSH_KNOWN_HOSTS: ${{ secrets.SRV_SSH_KNOWN_HOSTS }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$SSH_PRIVATE_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$SSH_KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts

      - name: Deploy generated website
        run: |
          rsync -az --delete \
            ./public/ \
            "${{ secrets.SRV_SSH_USER }}@${{ secrets.SRV_SSH_HOST }}:${{ secrets.SRV_DEPLOY_PATH }}/"
